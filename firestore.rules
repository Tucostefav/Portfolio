rules_version = '2';

// Reglas de seguridad de la base de datos.
//
// La idea es simple: cualquiera puede ENVIAR un mensaje desde el
// formulario de contacto, pero nadie puede leerlos ni borrarlos
// desde la web. Los mensajes se leen entrando a la consola de Firebase.

service cloud.firestore {
  match /databases/{database}/documents {

    match /mensajes/{mensaje} {
      // Nadie puede leer los mensajes desde el sitio
      allow read: if false;

      // Cualquiera puede crear uno, siempre que traiga los tres campos
      // y no sean textos gigantes
      allow create: if request.resource.data.keys().hasAll(['nombre', 'correo', 'mensaje'])
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() > 0
                    && request.resource.data.nombre.size() < 100
                    && request.resource.data.correo is string
                    && request.resource.data.correo.size() > 0
                    && request.resource.data.correo.size() < 200
                    && request.resource.data.mensaje is string
                    && request.resource.data.mensaje.size() > 0
                    && request.resource.data.mensaje.size() < 2000;

      // Nadie puede modificar ni borrar mensajes desde el sitio
      allow update, delete: if false;
    }

    // Todo lo demas queda cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
